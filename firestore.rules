rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.manufacturerId == request.auth.uid;
      allow update: if signedIn() && (resource.data.manufacturerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /transfers/{transferId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /deliveryPartners/{partnerId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /relationships/{relationshipId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /accountingEntries/{entryId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }
  }
}
